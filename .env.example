# --- Database ---
# These credentials are LOCAL-ONLY DEFAULTS for the docker-compose Postgres
# container. The container binds to 127.0.0.1 only and is not reachable from
# the network. If you deploy this anywhere outside your laptop, change these.
POSTGRES_USER=evaluser
POSTGRES_PASSWORD=evalpass
POSTGRES_DB=evallab
DATABASE_URL=postgresql+psycopg://evaluser:evalpass@db:5432/evallab

# --- Backend ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# --- LLM provider ---
# One of: openai | anthropic | mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
